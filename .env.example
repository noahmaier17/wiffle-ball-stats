# Supabase configuration
# Copy this file to .env.local and fill in your values from the Supabase project dashboard
# Read by both the browser client and the chat serverless function, which uses them to
# look up stats for the AI's tools.
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>

# Anthropic API key
# Copy this file to .env.local and fill in your values from your Anthropic console
ANTHROPIC_API_KEY=sk-ant-api03-<your-key>
